{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "description": "A push notification decision (stored server-side to enforce budget, batching, quiet hours, dedup).",
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "channels": {
          "items": {
            "enum": [
              "telegram",
              "webpush"
            ],
            "type": "string"
          },
          "title": "Channels",
          "type": "array"
        },
        "day_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'Ex-dividend today'",
          "title": "Day Label"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "explanations": {
          "description": "In priority order",
          "items": {
            "$ref": "#/$defs/MoveExplanation"
          },
          "title": "Explanations",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "move_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Adjusted close-to-close move"
        },
        "severity": {
          "enum": [
            "critical",
            "normal"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "sent",
            "batched",
            "held_quiet_hours",
            "over_budget",
            "suppressed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Reason"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "trading_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For price/volume alerts (IST trading day)",
          "title": "Trading Date"
        },
        "trigger": {
          "enum": [
            "filing",
            "price_move",
            "volume_spike"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "triggered_at": {
          "format": "date-time",
          "title": "Triggered At",
          "type": "string"
        },
        "volume_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Volume \u00f7 20-day average",
          "title": "Volume Ratio"
        },
        "z_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Z Score"
        }
      },
      "required": [
        "id",
        "symbol",
        "trigger",
        "event_id",
        "severity",
        "title",
        "body",
        "triggered_at",
        "trading_date",
        "move_pct",
        "z_score",
        "volume_ratio",
        "explanations",
        "day_label",
        "channels",
        "status",
        "status_reason"
      ],
      "title": "Alert",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "description": "A ranked Brief item. COMPUTED on read from Event + holdings + rules; never stored.",
      "properties": {
        "affects_drivers": {
          "description": "Driver labels for the \ud83d\udc41 tag",
          "items": {
            "type": "string"
          },
          "title": "Affects Drivers",
          "type": "array"
        },
        "as_of": {
          "description": "Freshness of the underlying data",
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "ask_chips": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Ask Chips",
          "type": "array"
        },
        "card_type": {
          "enum": [
            "results",
            "management_change",
            "price_volume",
            "what_to_watch",
            "one_liner",
            "inline_chip"
          ],
          "title": "Card Type",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "id": {
          "description": "Same as event_id (one card per event)",
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "impact_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_figures": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Key Figures",
          "type": "array"
        },
        "next_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action"
        },
        "rupee_impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u20b9 effect on this holding, when computable"
        },
        "score": {
          "$ref": "#/$defs/ScoreBreakdown"
        },
        "so_what": {
          "description": "\u226410 words",
          "title": "So What",
          "type": "string"
        },
        "sources": {
          "description": "Source chips (first = primary filing)",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Sources",
          "type": "array"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/TimelineItem"
          },
          "title": "Timeline",
          "type": "array"
        }
      },
      "required": [
        "id",
        "event_id",
        "symbol",
        "card_type",
        "category",
        "impact",
        "impact_reason",
        "headline",
        "so_what",
        "key_figures",
        "rupee_impact",
        "sources",
        "timeline",
        "next_action",
        "ask_chips",
        "affects_drivers",
        "score",
        "as_of"
      ],
      "title": "Card",
      "type": "object"
    },
    "Category": {
      "description": "FINN's filing taxonomy (PRODUCT.md \u00a74 'Category treatment').",
      "enum": [
        "results",
        "mna",
        "management_change",
        "litigation",
        "credit_rating",
        "pledging",
        "capex",
        "press_release",
        "insider_trading",
        "fund_raise",
        "dividend",
        "bonus_split",
        "earnings_call",
        "agm_egm",
        "postal_ballot",
        "investor_meetings",
        "unclassified"
      ],
      "title": "Category",
      "type": "string"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Where a number or claim came from. Every Figure/Claim that is not `not_found` carries one.",
      "properties": {
        "exchange": {
          "anyOf": [
            {
              "enum": [
                "NSE",
                "BSE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Machine locator when there is no page, e.g. 'in-capmkt:ProfitBeforeTax@OneD' or 'screener:quarters/Net Profit/Sep 2026'",
          "title": "Locator"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based PDF page",
          "title": "Page"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the source was published (UTC)",
          "title": "Published At"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim snippet supporting the value/claim",
          "title": "Quote"
        },
        "retrieved_at": {
          "description": "When FINN fetched it (UTC) \u2014 drives freshness stamps",
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human title, e.g. 'Q2 FY27 earnings call transcript'",
          "title": "Title"
        },
        "url": {
          "description": "Direct link to the document (exchange PDF, XBRL, etc.)",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "url",
        "title",
        "exchange",
        "page",
        "quote",
        "locator",
        "published_at",
        "retrieved_at"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "A sentence of text with provenance (snapshot lines, red flags, bull/bear bullets, impact reasons).",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "status",
        "citations"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Dossier": {
      "additionalProperties": false,
      "description": "Research dossier for any NSE ticker. Primary sources only; every number/claim cited.",
      "properties": {
        "analyst_questions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Analyst Questions",
          "type": "array"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "balance_sheet": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "title": "Balance Sheet",
          "type": "array"
        },
        "bear": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 3,
          "title": "Bear",
          "type": "array"
        },
        "bull": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 3,
          "title": "Bull",
          "type": "array"
        },
        "cash_quality": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "title": "Cash Quality",
          "type": "array"
        },
        "credibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Figure"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Management credibility score (computed in code)"
        },
        "headline_figures": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Headline Figures",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "promises": {
          "items": {
            "$ref": "#/$defs/Promise"
          },
          "title": "Promises",
          "type": "array"
        },
        "red_flags": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Red Flags",
          "type": "array"
        },
        "sections": {
          "additionalProperties": {
            "$ref": "#/$defs/DossierSection"
          },
          "description": "Per-section status",
          "title": "Sections",
          "type": "object"
        },
        "snapshot": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Snapshot",
          "type": "array"
        },
        "sources": {
          "description": "Every document read",
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Sources",
          "type": "array"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "template": {
          "description": "Banks/NBFCs: NII, PPOP, PAT; no EBITDA",
          "enum": [
            "standard",
            "bank",
            "nbfc"
          ],
          "title": "Template",
          "type": "string"
        },
        "trajectory": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "title": "Trajectory",
          "type": "array"
        },
        "trajectory_note": {
          "anyOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "symbol",
        "name",
        "template",
        "as_of",
        "snapshot",
        "headline_figures",
        "trajectory",
        "trajectory_note",
        "promises",
        "credibility",
        "cash_quality",
        "balance_sheet",
        "analyst_questions",
        "red_flags",
        "bull",
        "bear",
        "sections",
        "sources"
      ],
      "title": "Dossier",
      "type": "object"
    },
    "DossierSection": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'Not found in sources: segment revenue'",
          "title": "Note"
        },
        "status": {
          "enum": [
            "ready",
            "partial",
            "not_found"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "note"
      ],
      "title": "DossierSection",
      "type": "object"
    },
    "Driver": {
      "additionalProperties": false,
      "description": "Something the user watches for a holding (Level-1 relevance), suggested from disclosures.",
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Slug, e.g. 'TATAPOWER:renewables-capacity'",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "Short tag shown on cards, e.g. 'Margins'",
          "title": "Label",
          "type": "string"
        },
        "promise_ids": {
          "description": "Related Promise Ledger items",
          "items": {
            "type": "string"
          },
          "title": "Promise Ids",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why FINN suggested it, with citation"
        },
        "status": {
          "enum": [
            "suggested",
            "confirmed",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "id",
        "symbol",
        "label",
        "description",
        "status",
        "source",
        "promise_ids"
      ],
      "title": "Driver",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Filings about one real-world event, threaded into a single unit (one card in the Brief).",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "driver_ids": {
          "description": "Drivers this event touches",
          "items": {
            "type": "string"
          },
          "title": "Driver Ids",
          "type": "array"
        },
        "figures": {
          "description": "Extracted facts, e.g. results line items",
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Figures",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "impact_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "description": "Threading key, e.g. 'INFY:results:Q2 FY27' or 'HDFCBANK:management_change:2026-11-06'",
          "title": "Key",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For results events"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "timeline": {
          "items": {
            "$ref": "#/$defs/TimelineItem"
          },
          "title": "Timeline",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "symbol",
        "category",
        "title",
        "period",
        "started_at",
        "updated_at",
        "timeline",
        "figures",
        "impact",
        "impact_reason",
        "driver_ids"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventStage": {
      "description": "Where a filing sits in an event thread (intimation \u2192 outcome \u2192 deck \u2192 call \u2192 transcript \u2192 ad).",
      "enum": [
        "intimation",
        "outcome",
        "presentation",
        "call",
        "transcript",
        "newspaper_ad",
        "clarification",
        "other"
      ],
      "title": "EventStage",
      "type": "string"
    },
    "Figure": {
      "additionalProperties": false,
      "description": "A number with provenance. Money is float \u20b9 crore; see DECISIONS.md (float vs Decimal).",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "enum": [
                "consolidated",
                "standalone"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Consolidated/standalone \u2014 always set for financials",
          "title": "Basis"
        },
        "check_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cross-check detail, e.g. 'screener: 49,243 (\u0394 0.00%)'",
          "title": "Check Note"
        },
        "citation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Citation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For computed figures: human-readable formula",
          "title": "Formula"
        },
        "inputs": {
          "description": "For computed figures: the sourced inputs",
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "title": "Inputs",
          "type": "array"
        },
        "label": {
          "description": "e.g. 'Revenue from operations', 'EBITDA margin'",
          "title": "Label",
          "type": "string"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value exactly as printed, e.g. '1,23,456.78'",
          "title": "Raw"
        },
        "raw_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit as printed, e.g. 'lakh', 'million', 'crore'",
          "title": "Raw Unit"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null if and only if status == not_found",
          "title": "Value"
        }
      },
      "required": [
        "label",
        "value",
        "unit",
        "period",
        "basis",
        "status",
        "citation",
        "raw",
        "raw_unit",
        "check_note",
        "formula",
        "inputs"
      ],
      "title": "Figure",
      "type": "object"
    },
    "Filing": {
      "additionalProperties": false,
      "description": "One exchange announcement, as ingested. NSE and BSE copies of the same document are both kept;\nthe later one points at the first via `duplicate_of`.",
      "properties": {
        "attachment_url": {
          "anyOf": [
            {
              "type": "string"
