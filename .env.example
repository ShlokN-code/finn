# Copy to .env (backend) / web/.env.local (web). Never commit real values.

# --- backend (Render) ---
# Supabase → Connect → "Session pooler" URI (IPv4-compatible; Render free tier has no IPv6).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Comma-separated origins allowed to call the API from browsers (not needed while web proxies server-side).
CORS_ORIGINS=
PYTHON_VERSION=3.12.7

# --- web (Vercel) ---
# Server-side only (no NEXT_PUBLIC_ prefix): the browser talks to /api/* on Vercel, which proxies to Render.
API_BASE_URL=https://finn-api.onrender.com

# --- ingest jobs (GitHub Actions secrets; also put in a local .env for dev runs) ---
# Same DATABASE_URL as above. Jobs run on GitHub runners because NSE blocks Render.
# Gemini free tier (Google AI Studio, no billing). Free-tier inputs may be used by Google — we only send
# public exchange filings. Check model ids with: cd backend && python -m finn.llm.check
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash
# Optional text-only fallback when Gemini's quota is exhausted.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# Request budgets the router enforces (requests/minute, requests/day; day = Pacific midnight like Gemini's).
GEMINI_RPM=10
GEMINI_RPD=400
GROQ_RPM=20
GROQ_RPD=800
# Raw download cache directory (default backend/.cache).
# FINN_CACHE_DIR=

# --- later (not used yet) ---
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
