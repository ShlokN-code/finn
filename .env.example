# Copy to .env (backend) / web/.env.local (web). Never commit real values.

# --- backend (Render) ---
# Supabase → Connect → "Session pooler" URI (IPv4-compatible; Render free tier has no IPv6).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Comma-separated origins allowed to call the API from browsers (not needed while web proxies server-side).
CORS_ORIGINS=
PYTHON_VERSION=3.12.7

# --- web (Vercel) ---
# Server-side only (no NEXT_PUBLIC_ prefix): the browser talks to /api/* on Vercel, which proxies to Render.
API_BASE_URL=https://finn-api.onrender.com

# --- ingest jobs (GitHub Actions secrets; also put in a local .env for dev runs) ---
# Same DATABASE_URL as above. Jobs run on GitHub runners because NSE blocks Render.
# Gemini free tier (Google AI Studio, no billing). Free-tier inputs may be used by Google — we only send
# public exchange filings. Check model ids with: cd backend && python -m finn.llm.check
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash
# Strong-tier fallbacks, each with its own free daily quota (never Flash-Lite).
GEMINI_MODEL_STRONG_FALLBACKS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash
# Optional text-only fallback when Gemini's quota is exhausted.
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# Request budgets the router enforces (requests/minute, requests/day; day = Pacific midnight like Gemini's).
GEMINI_RPM=10
GEMINI_RPD=400
GROQ_RPM=20
GROQ_RPD=800
# Research lane daily caps (Pacific day, like Gemini's): Flash-Lite calls for dossiers (incl. Ask), Ask alone, strong.
RESEARCH_CHEAP_RPD=220
RESEARCH_ASK_RPD=40
RESEARCH_STRONG_RPD=60
# Raw download cache directory (default backend/.cache).
# FINN_CACHE_DIR=

# --- Research dossiers (Phase 3, Render) ---
# Start the background build worker in this process (Render only; uvicorn --workers 1).
RESEARCH_WORKER=
# New (first-time) dossiers per IST day — protects the push side's model quota.
RESEARCH_DAILY_BUILDS=15

# --- Telegram (Phase 2) ---
# From @BotFather. Needed on Render (webhook, test alert) and as a GitHub secret (alert dispatch).
TELEGRAM_BOT_TOKEN=
# Bot username without @ (Render): builds the t.me deep link.
TELEGRAM_BOT_USERNAME=
# Random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`), Render only.
# Telegram sends it back on every webhook call; the API rejects calls without it.
TELEGRAM_WEBHOOK_SECRET=
# Public URLs: the web app (for "Open in FINN" buttons; Render + GitHub variable) and the API (local setup only).
WEB_BASE_URL=https://finn-<something>.vercel.app
API_PUBLIC_URL=https://finn-api-4ejm.onrender.com

# --- Web search for management-change profiles (optional; cards work from the filing alone without it) ---
# TAVILY_API_KEY=

# --- later (not used yet) ---
# ANTHROPIC_API_KEY=
