{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && ../.venv/bin/uvicorn api.main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web && API_BASE_URL=http://127.0.0.1:8000 npm run dev -- --port 3000"],
      "port": 3000
    }
  ]
}
